{
  "name": "bbg-panel",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "author": "SANDBAAD",
  "description": "BBG by SANDBAAD \u2014 multi-core (Xray / sing-box) VPN panel, with a Cloudflare Worker edition and a one-token installer",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "check": "node scripts/preflight.js",
    "build:worker": "node scripts/build-worker.mjs",
    "deploy:panel": "node scripts/build-worker.mjs && wrangler deploy",
    "deploy:installer": "node scripts/build-worker.mjs && cd installer && wrangler deploy",
    "test": "node --import ./tests/cf-shim/register.mjs --import ./tests/cf-shim/runtime.mjs tests/worker.test.mjs && node --import ./tests/cf-shim/register.mjs --import ./tests/cf-shim/runtime.mjs tests/installer.test.mjs"
  },
  "dependencies": {}
}
